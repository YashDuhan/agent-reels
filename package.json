    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YashDuhan/agent-reels.git"
  },
  "homepage": "https://github.com/YashDuhan/agent-reels#readme",
  "bugs": {
    "url": "https://github.com/YashDuhan/agent-reels/issues"
  }
