{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "reels-window-controls",
  "description": "Lets the page's drag, resize and close controls and its right-click menu move, resize, close and keep on top the player window. Nothing else is exposed to Instagram.",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "https://www.instagram.com/*",
      "https://instagram.com/*"
    ]
  },
  "permissions": [
    "core:window:allow-start-dragging",
    "core:window:allow-start-resize-dragging",
    "allow-set-pinned",
    "allow-quit-player",
    "allow-set-on-top"
  ]
}
